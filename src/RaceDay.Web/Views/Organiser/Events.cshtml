@model List<OrganiserEventDto>
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="rd-page-title mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty text-center">
        <i class="bi bi-calendar-plus rd-empty-icon"></i>
        <h3>No events yet</h3>
        <p>Create your first event to get started.</p>
        <a asp-action="CreateEvent" class="btn btn-primary">Create an event</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card rd-event-card h-100">
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventID" class="rd-event-banner" aria-label="View @ev.EventName">
                        @if (ev.HasBanner)
                        {
                            <img src="~/media/events/@ev.EventID" alt="Banner for @ev.EventName" loading="lazy" />
                        }
                        else
                        {
                            <div class="rd-banner-placeholder"><i class="bi @UiHelpers.TypeIcon(ev.EventType)"></i></div>
                        }
                        <span class="rd-type-chip"><i class="bi @UiHelpers.TypeIcon(ev.EventType)"></i> @ev.EventType</span>
                    </a>
                    <div class="card-body d-flex flex-column">
                        <div class="rd-date-line"><i class="bi bi-calendar-event"></i> @UiHelpers.FormatDate(ev.EventDate)</div>
                        <h3 class="rd-card-title">@ev.EventName</h3>
                        <ul class="rd-meta list-unstyled mb-3">
                            <li><i class="bi bi-geo-alt"></i> @ev.Location</li>
                            <li><i class="bi bi-signpost-split"></i> @ev.DistanceKm.ToString("0.##") km</li>
                            <li><i class="bi bi-people"></i> @ev.ConfirmedEnrolments enrolled &middot; @ev.CategoryCount categories</li>
                        </ul>
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a asp-action="Categories" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-secondary"><i class="bi bi-tags"></i> Categories</a>
                            <a asp-action="Enrolments" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-secondary"><i class="bi bi-people"></i> Enrolments</a>
                            <a asp-action="Results" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-secondary"><i class="bi bi-stopwatch"></i> Results</a>
                        </div>
                        <hr />
                        <div class="d-flex gap-2">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventID" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-pencil"></i> Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
