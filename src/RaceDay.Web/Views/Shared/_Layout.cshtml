@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var isOrganiser = User.IsInRole("Organiser");
    var isParticipant = User.IsInRole("Participant");
    var userName = User.Identity?.Name ?? "";
    var hasPicture = Context.Session.GetString("HasPicture") == "1";

    string Active(string c, params string[] actions) =>
        controller == c && (actions.Length == 0 || actions.Contains(action)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230B1B3A'/%3E%3Cpath d='M56 12 30 54h18l-6 34 28-44H52z' fill='%23FF5A1F'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;1,700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i> RACE<span>DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isOrganiser)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Organiser", "Events", "CreateEvent", "EditEvent", "Categories", "EditCategory", "Enrolments", "Results")" asp-controller="Organiser" asp-action="Events"><i class="bi bi-calendar-event"></i> My events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent"><i class="bi bi-plus-circle"></i> New event</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-flag"></i> Events</a></li>
                            @if (isParticipant)
                            {
                                <li class="nav-item"><a class="nav-link @Active("Participant", "MyEnrolments")" asp-controller="Participant" asp-action="MyEnrolments"><i class="bi bi-ticket-perforated"></i> My enrolments</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults"><i class="bi bi-trophy"></i> My results</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2 @Active("Account", "Profile")" asp-controller="Account" asp-action="Profile">
                                    @if (hasPicture)
                                    {
                                        <img class="rd-avatar" src="~/media/profile" alt="Your profile picture" />
                                    }
                                    else
                                    {
                                        <span class="rd-avatar rd-avatar-initials">@UiHelpers.Initials(userName)</span>
                                    }
                                    <span>@userName <small class="rd-role-chip">@(isOrganiser ? "Organiser" : "Participant")</small></span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="rd-main">
        <div class="container">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><i class="bi bi-lightning-charge-fill"></i> RaceDay &middot; South African running, walking &amp; cycling events</span>
            <span>&copy; @DateTime.Now.Year RaceDay</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
