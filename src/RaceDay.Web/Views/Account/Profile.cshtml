@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}
<h1 class="rd-page-title">My profile</h1>

<div class="row g-4">
    <div class="col-12 col-md-4">
        <div class="card rd-form-card text-center">
            <div class="card-body">
                @if (Model.HasProfilePicture)
                {
                    <img src="~/media/profile?v=@DateTime.UtcNow.Ticks" alt="Your profile picture" class="rd-profile-photo" />
                }
                else
                {
                    <div class="rd-profile-photo rd-profile-initials">@UiHelpers.Initials(Model.FullName)</div>
                }
                <h2 class="rd-card-title mt-3 mb-0">@Model.FullName</h2>
                <p class="text-muted mb-1">@Model.Role</p>
                <small class="text-muted">Member since @Model.MemberSince.ToString("d MMM yyyy")</small>

                <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-4 text-start">
                    <label class="form-label" for="picture">Profile picture</label>
                    <input type="file" id="picture" name="picture" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" required />
                    <div class="form-text">JPG, PNG, GIF or WebP, up to 5 MB.</div>
                    <button type="submit" class="btn btn-outline-primary w-100 mt-3"><i class="bi bi-upload"></i> Upload picture</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8">
        <div class="card rd-form-card">
            <div class="card-body">
                <h2 class="rd-card-heading">Personal information</h2>
                <form asp-action="Profile" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
